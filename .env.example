# RevGuard environment variables — NEVER commit this file to git
# Copy this to .env and fill in real values.

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Provider (groq | gemini)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_XXXXXXXXXX
GEMINI_API_KEY=AIzaSy_XXXXXXXXXX

# ── Twilio (real WhatsApp send + inbound replies) ──────────────────────────────
# All three must be set for messages to actually go out. With any of them
# missing, dispatch is logged and skipped rather than failing the pipeline.
# TWILIO_WHATSAPP_SENDER must include the channel prefix, e.g.
#   whatsapp:+14155238886   (Twilio's WhatsApp sandbox number)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_WHATSAPP_SENDER=whatsapp:+14155238886

# Point your Twilio WhatsApp sandbox "when a message comes in" webhook at:
#   https://<your-render-service>.onrender.com/twilio/webhook

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave empty to use SQLite (aiosqlite)
# Render prod: Handled automatically by render.yaml (do not set manually)
# Custom prod: postgresql://user:pass@host:port/dbname
DATABASE_URL=

# ── App Config ────────────────────────────────────────────────────────────────
POLICY_FILE=policy.yaml
TZ=Asia/Kolkata
APP_ENV=development

# RevGuard environment variables — NEVER commit this file to git
# Copy this to .env and fill in real values.

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Provider (groq | gemini)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_XXXXXXXXXX
GEMINI_API_KEY=AIzaSy_XXXXXXXXXX

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: leave empty to use SQLite (aiosqlite)
# Render prod: Handled automatically by render.yaml (do not set manually)
# Custom prod: postgresql://user:pass@host:port/dbname
DATABASE_URL=

# ── App Config ────────────────────────────────────────────────────────────────
POLICY_FILE=policy.yaml
TZ=Asia/Kolkata
APP_ENV=development
